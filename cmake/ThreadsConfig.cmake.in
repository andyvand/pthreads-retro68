# Threads package configuration for Retro68 (provided by pthreads-retro68).
#
#   find_package(Threads CONFIG REQUIRED)       # or plain find_package(Threads)
#   target_link_libraries(myapp PRIVATE Threads::Threads)
#
# Sets the same result variables as CMake's FindThreads module.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(pthreads-retro68 CONFIG
    PATHS "@PACKAGE_PTR_CMAKE_DIR@" NO_DEFAULT_PATH)

if(NOT TARGET Threads::Threads)
    add_library(Threads::Threads INTERFACE IMPORTED)
    set_target_properties(Threads::Threads PROPERTIES
        INTERFACE_LINK_LIBRARIES pthreads-retro68::pthread)
endif()

set(Threads_FOUND TRUE)
set(CMAKE_THREAD_LIBS_INIT pthreads-retro68::pthread)
set(CMAKE_USE_PTHREADS_INIT 1)
set(CMAKE_USE_WIN32_THREADS_INIT 0)
set(CMAKE_HP_PTHREADS_INIT 0)
set(CMAKE_USE_SPROC_INIT 0)
set(THREADS_PREFER_PTHREAD_FLAG_SUPPORTED FALSE)
