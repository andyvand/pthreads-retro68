# pthreads-retro68 CMake package configuration.
#
#   find_package(pthreads-retro68 REQUIRED)
#   target_link_libraries(myapp PRIVATE pthreads-retro68::pthread)
#
# The 68k, PowerPC and Carbon builds each install their own targets file;
# the one matching the consumer's toolchain (CMAKE_SYSTEM_NAME) is loaded.
@PACKAGE_INIT@

set(_ptr_targets "${CMAKE_CURRENT_LIST_DIR}/pthreads-retro68-targets-${CMAKE_SYSTEM_NAME}.cmake")
if(NOT EXISTS "${_ptr_targets}")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "pthreads-retro68 was not built for CMAKE_SYSTEM_NAME '${CMAKE_SYSTEM_NAME}' (missing ${_ptr_targets})")
    unset(_ptr_targets)
    return()
endif()

if(NOT TARGET pthreads-retro68::pthread)
    include("${_ptr_targets}")
endif()
unset(_ptr_targets)

set(pthreads-retro68_LIBRARIES pthreads-retro68::pthread)
